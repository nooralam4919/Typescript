// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



// ===============================
// ENUMS
// ===============================

enum AuthProvider {
  LOCAL
  GITHUB
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum ScanType {
  MANUAL
  WEBHOOK
  SCHEDULED
}

enum JobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
}


// ===============================
// USER
// ===============================

model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  password       String?

  avatarUrl      String?

  provider       AuthProvider   @default(LOCAL)
  githubId       String?        @unique
  githubUsername String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  projects       Project[]
  scans          Scan[]

  githubAccount  GithubAccount?
  accessToken    String?
  refreshTokens  RefreshToken[]
}

// ===============================
// GITHUB ACCOUNT
// ===============================

model GithubAccount {
  id          String   @id @default(uuid())
  userId      String   @unique

  githubId    String   @unique
  username    String
  accessToken String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// ===============================
// PROJECT / REPOSITORY
// ===============================

model Project {
  id             String            @id @default(uuid())

  name           String
  description    String?

  repositoryUrl  String
  repositoryName String?
  githubRepoId   String?

  visibility     ProjectVisibility @default(PRIVATE)
  status         ProjectStatus     @default(ACTIVE)

  ownerId        String

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  scans          Scan[]

  @@index([ownerId])
  @@index([githubRepoId])
}


// ===============================
// SCAN
// ===============================

model Scan {
  id            String     @id @default(uuid())

  projectId     String
  userId        String

  type          ScanType   @default(MANUAL)
  status        ScanStatus @default(QUEUED)

  branch        String?
  commitHash    String?

  startedAt     DateTime?
  completedAt   DateTime?

  totalFiles    Int        @default(0)
  scannedFiles  Int        @default(0)

  totalFindings Int        @default(0)
  criticalCount Int        @default(0)
  highCount     Int        @default(0)
  mediumCount   Int        @default(0)
  lowCount      Int        @default(0)

  errorMessage  String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  findings      Finding[]
  jobs          ScanJob[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ===============================
// SECURITY FINDING
// ===============================

model Finding {
  id             String          @id @default(uuid())

  scanId         String

  ruleId         String
  ruleName       String

  severity       FindingSeverity
  status         FindingStatus   @default(OPEN)

  title          String
  description    String?

  filePath       String
  lineNumber     Int?
  columnNumber   Int?

  codeSnippet    String?
  recommendation String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  scan           Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([severity])
  @@index([status])
  @@index([ruleId])
}

// ===============================
// SCAN JOB
// ===============================

model ScanJob {
  id           String    @id @default(uuid())

  scanId       String
  jobId        String?   @unique

  status       JobStatus @default(WAITING)
  attempts     Int       @default(0)

  startedAt    DateTime?
  completedAt  DateTime?

  errorMessage String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  scan         Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([status])
}

// ===============================
// REFRESH TOKEN
// ===============================

model RefreshToken {
  id        String   @id @default(uuid())

  userId    String
  tokenHash String   @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}